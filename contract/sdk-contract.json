{
  "$comment": "The chronicle SDK contract (chronicle-hq design 12): the wire described once, restated by every SDK. The Go contract package proves it matches; an SDK generates its types, constants and error enum from it and nothing else. The words are the user's (chronicle-hq/00-META/vocabulary.md, decision 0044): a store, its types, their instances named by paths, children, snapshots; the protocol tokens underneath — subjects, verb names, headers, resource names, the log. META prefix — do not change with the words.",
  "version": "2.0.0",
  "shapes": [
    {
      "name": "request-reply",
      "description": "one request, one reply; no responder is a typed error"
    },
    {
      "name": "streamed-reply",
      "description": "one request; chunks and a trailer from one responder; ends on the trailer, a stall or the deadline is the safety net"
    },
    {
      "name": "scatter-gather",
      "description": "one request, any responder may answer; ends on a deadline or a count; zero answers is an empty result. Not on chronicle's wire: an application's own"
    },
    {
      "name": "batch-publish",
      "description": "many messages, one commit ack: the server's atomic batch publish. Described, unbuilt until a consumer exists"
    },
    {
      "name": "publish",
      "description": "a guarded JetStream publish: every append"
    },
    {
      "name": "subscribe",
      "description": "a resumable JetStream read — an ordered consumer or a KV scan or watch — never a core subscription"
    }
  ],
  "headers": {
    "operation": {
      "Nats-Msg-Id": "the op ID and the dedup key, made once by the writer, kept across retries",
      "Op-Type": "the operation's kind in the log's vocabulary",
      "Op-Author": "the principal ID, stamped from the credentials",
      "Op-Parents": "the op IDs the writer had seen, one header value per parent",
      "Op-Ts": "author-claimed clock, RFC 3339, informational only",
      "Op-Version": "the envelope version"
    },
    "envelopeVersion": "1",
    "guards": {
      "Nats-Expected-Last-Subject-Sequence": "JetStream's per-subject CAS; 0 is create",
      "Nats-Rollup": "a snapshot that replaces its subject's history; only ever the rollup subject value"
    },
    "rollupSubject": "sub",
    "stream": {
      "Chron-Chunk": "a message's position in a streamed reply, from 1, increasing by one; the trailer continues the numbering",
      "Chron-End": "marks the trailer; carries the count of items sent across every chunk"
    },
    "serviceError": {
      "Nats-Service-Error-Code": "a code from the error catalog",
      "Nats-Service-Error": "the description"
    }
  },
  "grammars": {
    "name": {
      "pattern": "^[a-z0-9-]+$",
      "appliesTo": [
        "store",
        "index",
        "type",
        "principal",
        "child name"
      ]
    },
    "instanceToken": {
      "pattern": "^[a-zA-Z0-9_-]+$",
      "note": "one segment of an instance's path; a path is the segments joined with '/' as the user writes it, and with '.' as it is stored — the tail, which is also the state bucket's key"
    },
    "path": {
      "separator": "/",
      "storedSeparator": ".",
      "note": "type/id, then name/id for each child, e.g. invoice/inv-1/comments/c-3; converted to and from the stored tail segment for segment"
    },
    "reservedStoreNames": [
      "api",
      "meta",
      "sys"
    ],
    "servicePrincipal": "chronicle",
    "root": "CHRON",
    "metaBucket": "META",
    "snapshotOpType": "snapshot",
    "stateFoldKey": "=fold",
    "derivations": {
      "upperStore": "the store name uppercased with '-' mapped to '_'",
      "stream": "LOG_<STORE>",
      "stateBucket": "STATE_<STORE>",
      "storeSubjects": "CHRON.<store>.>",
      "opsFilter": "CHRON.<store>.OPS.>",
      "opsSubject": "CHRON.<store>.OPS.<tail>"
    },
    "metaKeys": {
      "storeConfig": "log.<store>.config",
      "type": "log.<store>.type.<type>",
      "index": "index.<store>.<index>",
      "principal": "identity.principal.<id>",
      "member": "identity.member.<id>",
      "invite": "identity.invite.<digest>"
    },
    "roles": [
      "admin",
      "writer",
      "reader"
    ],
    "effects": [
      "merge",
      "none"
    ],
    "history": [
      "compactable",
      "full"
    ],
    "indexKinds": [
      "state",
      "search",
      "graph",
      "semantic"
    ],
    "principalKinds": [
      "member",
      "service"
    ]
  },
  "records": {
    "typeRecord": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "schema": {
          "type": [
            "object",
            "boolean"
          ],
          "description": "a JSON Schema document"
        },
        "history": {
          "type": "string",
          "enum": [
            "compactable",
            "full"
          ]
        },
        "children": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": "{name → type}: the child types that may live under an instance of this type"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "schema": {
                "type": [
                  "object",
                  "boolean"
                ],
                "description": "a JSON Schema document"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "merge",
                  "none"
                ]
              }
            },
            "required": [
              "schema"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "revision",
        "schema"
      ]
    },
    "indexDeclaration": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "config": {
          "description": "any JSON"
        }
      },
      "required": [
        "kind"
      ]
    },
    "stateValue": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "description": "the stream sequence the state was folded to"
        },
        "state": {
          "description": "any JSON"
        }
      },
      "required": [
        "seq",
        "state"
      ]
    },
    "snapshotPayload": {
      "type": "object",
      "properties": {
        "state": {
          "description": "any JSON"
        },
        "frontier": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state"
      ]
    },
    "op": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "description": "the stream sequence — the only order"
        },
        "id": {
          "type": "string",
          "description": "Nats-Msg-Id"
        },
        "type": {
          "type": "string",
          "description": "Op-Type"
        },
        "author": {
          "type": "string",
          "description": "Op-Author"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ts": {
          "type": "string",
          "description": "Op-Ts, RFC 3339; informational only"
        },
        "payload": {
          "description": "any JSON"
        }
      },
      "required": [
        "seq",
        "id",
        "type",
        "author",
        "payload"
      ]
    }
  },
  "streamSettings": {
    "duplicateWindowSeconds": 120,
    "defaultMaxBytes": 1073741824
  },
  "clientDefaults": {
    "streamStallSeconds": 5,
    "streamPendingMsgs": 65536,
    "streamPendingBytes": 67108864,
    "chunkByteBudget": 262144,
    "dedupWindowSeconds": 120
  },
  "fold": {
    "decisions": [
      "merge",
      "none",
      "unknown-type",
      "unknown-effect",
      "bad-type-record",
      "invalid",
      "undeclared",
      "reset",
      "malformed-snapshot"
    ],
    "rules": "resolve the tail (the path as stored) first: an undeclared child (one its parent type does not declare) is marked and moves nothing; a snapshot resets state to its payload's, judged against the instance schema when typed; a declared merge applies RFC 7386 onto current state, empty included; none, an unknown type, an unknown effect, a bad record or an invalid payload moves nothing; an untyped subject moves only by snapshot"
  },
  "errors": [
    {
      "code": "500",
      "meaning": "the service failed; the description says how"
    },
    {
      "code": "bad-request",
      "meaning": "the request body does not decode, or a required field is missing"
    },
    {
      "code": "forbidden",
      "meaning": "the principal's role does not admit the verb"
    },
    {
      "code": "not-a-member",
      "meaning": "the principal is not a member of the account"
    },
    {
      "code": "bad-store-name",
      "meaning": "the store name is outside [a-z0-9-]+ or reserved"
    },
    {
      "code": "bad-index-name",
      "meaning": "the index name is outside [a-z0-9-]+"
    },
    {
      "code": "bad-type-name",
      "meaning": "the type name is outside [a-z0-9-]+"
    },
    {
      "code": "bad-principal-name",
      "meaning": "the principal name is outside [a-z0-9-]+ or reserved"
    },
    {
      "code": "bad-instance",
      "meaning": "the instance path has a segment outside [a-zA-Z0-9_-]+"
    },
    {
      "code": "bad-role",
      "meaning": "the role is outside the vocabulary (admin, writer, reader)"
    },
    {
      "code": "bad-history",
      "meaning": "the history policy is outside the vocabulary (compactable, full)"
    },
    {
      "code": "bad-kind",
      "meaning": "the index kind is outside the vocabulary (search, graph, semantic)"
    },
    {
      "code": "bad-config",
      "meaning": "the index config does not parse under its kind's contract"
    },
    {
      "code": "bad-schema",
      "meaning": "a JSON Schema in the type record does not compile"
    },
    {
      "code": "bad-effect",
      "meaning": "an operation's effect is outside the vocabulary (merge, none)"
    },
    {
      "code": "bad-op-type",
      "meaning": "an operation's name is not a valid op type"
    },
    {
      "code": "bad-child-name",
      "meaning": "a child name is outside [a-z0-9-]+"
    },
    {
      "code": "bad-child-type",
      "meaning": "a child names a type outside [a-z0-9-]+"
    },
    {
      "code": "bad-op",
      "meaning": "the query's op is outside the index kind's vocabulary"
    },
    {
      "code": "bad-direction",
      "meaning": "the graph direction is outside the vocabulary (out, in, both)"
    },
    {
      "code": "store-exists",
      "meaning": "the store already exists"
    },
    {
      "code": "index-exists",
      "meaning": "the index is already declared"
    },
    {
      "code": "member-exists",
      "meaning": "the member is already registered"
    },
    {
      "code": "no-such-store",
      "meaning": "the store does not exist"
    },
    {
      "code": "no-such-index",
      "meaning": "the index is not declared"
    },
    {
      "code": "no-such-instance",
      "meaning": "the instance has no history in the store"
    },
    {
      "code": "reserved-state-index",
      "meaning": "state is not an index a caller declares or deletes; it is read as the instance's state"
    },
    {
      "code": "provider-unavailable",
      "meaning": "the semantic kind's embedding provider did not answer"
    }
  ],
