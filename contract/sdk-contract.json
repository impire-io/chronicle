            ]
          }
        },
        "required": [
          "principal",
          "log"
        ],
        "additionalProperties": false
      },
      "reply": {
        "type": "object",
        "properties": {
          "stream": {
            "type": "string",
            "description": "the created stream, LOG_<LOG>"
          }
        },
        "required": [
          "stream"
        ],
        "additionalProperties": false
      },
      "errors": [
        "500",
        "bad-request",
        "forbidden",
        "not-a-member",
        "bad-log-name",
        "bad-history",
        "log-exists"
      ]
    },
