{
  "name": "the spine",
  "$comment": "One account end to end over the quick start: create a store, define a type, create a instance, do operations, guard one, miss the guard, read state, replay, roll up, declare and query an index, list everything as an iterator. Every step names a sentence of design 07 and an interaction of the artifact.",
  "steps": [
    {
      "do": "store.create",
      "store": "orders"
    },
    {
      "do": "store.create",
      "store": "orders",
      "expect": {
        "error": "store-exists"
      }
    },
    {
      "do": "type.define",
      "store": "orders",
      "type": "invoice",
      "def": {
        "schema": {
          "type": "object",
          "required": [
            "total"
          ]
        },
        "children": {
          "comments": "comment"
        },
        "operations": {
          "create": {
            "schema": {
              "type": "object"
            },
            "effect": "merge"
          },
          "send": {
            "schema": {
              "type": "object",
              "required": [
                "to"
              ]
            },
            "effect": "merge"
          },
          "note": {
            "schema": {
              "type": "object"
            },
            "effect": "none"
          }
        }
      }
    },
    {
      "do": "type.define",
      "store": "orders",
      "type": "comment",
      "def": {
        "schema": {},
        "operations": {
          "create": {
            "schema": {
              "type": "object"
            },
            "effect": "merge"
          }
        }
      }
    },
    {
      "do": "instance.create",
      "store": "orders",
      "instance": "invoice/inv-1",
      "payload": {
        "total": 120
      }
    },
    {
      "do": "instance.create",
      "store": "orders",
      "instance": "invoice/inv-1",
      "payload": {
        "total": 999
      },
      "expect": {
        "error": "instance-exists"
      }
    },
    {
      "do": "apply",
      "store": "orders",
      "instance": "invoice/inv-1",
      "op": "send",
      "payload": {
        "to": "x"
      }
    },
    {
      "do": "apply",
      "store": "orders",
      "instance": "invoice/inv-1",
      "op": "send",
      "payload": {},
      "expect": {
        "error": "preflight"
      }
    },
    {
      "do": "apply",
      "store": "orders",
      "instance": "invoice/inv-1",
      "op": "frobnicate",
      "payload": {},
      "expect": {
        "error": "undefined-operation"
      }
    },
    {
      "do": "get",
      "store": "orders",
      "instance": "invoice/inv-1",
      "expect": {
        "state": {
          "total": 120,
          "to": "x"
        }
      }
    },
    {
      "do": "apply",
      "store": "orders",
      "instance": "invoice/inv-1",
      "op": "note",
      "payload": {
        "text": "hi"
      },
      "expectSeq": 1,
      "expect": {
        "error": "instance-moved"
      }
    },
    {
      "do": "apply.guarded",
      "store": "orders",
      "instance": "invoice/inv-1",
      "op": "note",
      "payload": {
        "text": "hi"
      }
    },
    {
      "do": "history",
      "store": "orders",
      "instance": "invoice/inv-1",
      "expect": {
        "types": [
          "create",
          "send",
          "note"
        ]
      }
    },
    {
      "do": "instance.create",
      "store": "orders",
      "instance": "invoice/inv-1/comments/c-1",
      "payload": {
        "text": "first"
      }
    },
    {
      "do": "instance.create",
      "store": "orders",
      "instance": "invoice/inv-1/notes/n-1",
      "payload": {},
      "expect": {
        "error": "preflight"
      }
    },
    {
      "do": "instance.create.snapshot",
      "store": "orders",
      "instance": "widget/w-1",
      "payload": {
        "a": 1
      }
    },
    {
      "do": "get",
      "store": "orders",
      "instance": "widget/w-1",
      "expect": {
        "state": {
          "a": 1
        }
      }
    },
    {
      "do": "snapshot",
      "store": "orders",
      "instance": "invoice/inv-1",
      "expect": {
        "taken": true
      },
      "$comment": "a typed, compactable instance absorbs its history whole (0022 § 5): no per-op veto"
    },
    {
      "do": "history",
      "store": "orders",
      "instance": "invoice/inv-1",
      "expect": {
        "types": [
          "snapshot"
        ]
      }
    },
    {
      "do": "snapshot",
      "store": "orders",
      "instance": "widget/w-1",
      "expect": {
        "taken": false
      },
      "$comment": "an untyped instance with only a snapshot has nothing to compact; declining is an answer"
    },
    {
      "do": "index.declare",
      "store": "orders",
      "index": "text",
      "kind": "search"
    },
    {
      "do": "index.declare",
      "store": "orders",
      "index": "state",
      "kind": "state",
      "expect": {
        "error": "reserved-state-index"
      }
    },
    {
      "do": "query",
      "store": "orders",
      "index": "text",
      "text": "x",
      "expect": {
        "instances": [
          "invoice/inv-1"
        ],
        "total": 1
      }
    },
    {
      "do": "query",
      "store": "orders",
      "index": "text",
      "text": "",
      "limit": 1,
      "expect": {
        "count": 1,
        "total": 3
      }
    },
    {
      "do": "query",
      "store": "orders",
      "index": "nowhere",
      "text": "x",
      "expect": {
        "error": "no-responder"
      }
    },
    {
      "do": "list.stores",
      "expect": {
        "items": [
          "orders"
        ]
      }
    },
    {
      "do": "list.types",
      "store": "orders",
      "expect": {
        "items": [
          "comment",
          "invoice"
        ]
      }
    },
    {
      "do": "list.indexes",
      "store": "orders",
      "expect": {
        "items": [
          "text"
        ]
      }
    },
    {
      "do": "list.instances",
      "store": "orders",
      "expect": {
        "items": [
          "invoice/inv-1",
          "invoice/inv-1/comments/c-1",
          "widget/w-1"
        ]
      }
    },
    {
      "do": "list.instances",
      "store": "orders",
      "in": "invoice/inv-1",
      "expect": {
        "items": [
          "invoice/inv-1/comments/c-1"
        ]
      }
    },
    {
      "do": "list.instances",
      "store": "orders",
      "type": "invoice",
      "expect": {
        "items": [
          "invoice/inv-1"
        ]
      },
      "$comment": "the instances of one type: top level, children excluded"
    },
    {
      "do": "list.instances",
      "store": "orders",
      "in": "invoice/inv-1",
      "type": "comment",
      "expect": {
        "items": [
          "invoice/inv-1/comments/c-1"
        ]
      },
      "$comment": "a parent's children of one type, by its children map"
    },
    {
      "do": "list.instances",
      "store": "orders",
      "where": {
        "a": "1"
      },
      "expect": {
        "items": [
          "widget/w-1"
        ]
      },
      "$comment": "a field filter on the state"
    },
    {
      "do": "index.delete",
      "store": "orders",
      "index": "text"
    },
    {
      "do": "list.indexes",
      "store": "orders",
      "expect": {
        "items": []
      }
    }
  ]
}
