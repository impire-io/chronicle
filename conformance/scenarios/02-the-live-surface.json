{
  "name": "the live surface",
  "$comment": "The subscribe shape: a watch yields the current value then every change; a tail yields what lands after it started; declarations arrive as they are made. Each subscribe step opens the iterator, performs the write in `then`, and expects the item within the timeout.",
  "steps": [
    {
      "do": "store.create",
      "store": "orders"
    },
    {
      "do": "type.define",
      "store": "orders",
      "type": "invoice",
      "def": {
        "schema": {
          "type": "object"
        },
        "operations": {
          "create": {
            "schema": {
              "type": "object"
            },
            "effect": "merge"
          },
          "send": {
            "schema": {
              "type": "object"
            },
            "effect": "merge"
          }
        }
      }
    },
    {
      "do": "instance.create",
      "store": "orders",
      "instance": "invoice/inv-1",
      "payload": {
        "total": 1
      }
    },
    {
      "do": "get",
      "store": "orders",
      "instance": "invoice/inv-1",
      "expect": {
        "state": {
          "total": 1
        }
      }
    },
    {
      "do": "watch",
      "store": "orders",
      "instance": "invoice/inv-1",
      "then": {
        "do": "apply",
        "store": "orders",
        "instance": "invoice/inv-1",
        "op": "send",
        "payload": {
          "to": "y"
        }
      },
      "expect": {
        "first": {
          "total": 1
        },
        "contains": {
          "to": "y"
        }
      }
    },
    {
      "do": "tail",
      "store": "orders",
      "instance": "",
      "live": true,
      "then": {
        "do": "apply",
        "store": "orders",
        "instance": "invoice/inv-1",
        "op": "send",
        "payload": {
          "to": "z"
        }
      },
      "expect": {
        "type": "send"
      }
    },
    {
      "do": "tail",
      "store": "orders",
      "instance": "invoice/inv-1",
      "after": 1,
      "expect": {
        "types": [
          "send",
          "send"
        ]
      }
    },
    {
      "do": "watch.declarations",
      "store": "orders",
      "then": {
        "do": "index.declare",
        "store": "orders",
        "index": "text",
        "kind": "search"
      },
      "expect": {
        "first": [
          "type:invoice",
          "index:state"
        ],
        "arrives": "index:text"
      }
    }
  ]
}
