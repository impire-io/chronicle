      "schema": {},
      "children": {
        "kids": "ghost"
      }
    },
    "ticket": {
      "revision": 1,
      "schema": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "closed"
            }
          }
        },
        "then": {
          "required": [
            "closed"
          ]
        },
        "else": {
          "not": {
            "required": [
              "closed"
            ]
          }
        }
      },
      "operations": {
        "create": {
          "schema": {
            "type": "object"
          },
          "effect": "merge"
        },
        "close": {
          "schema": {
            "type": "object",
            "required": [
              "status",
              "closed"
            ]
          },
          "effect": "merge",
          "precondition": {
            "properties": {
              "status": {
                "const": "open"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "reopen": {
          "schema": {
            "type": "object",
            "required": [
              "status"
            ]
          },
          "effect": "merge",
          "precondition": {
            "properties": {
              "status": {
                "const": "closed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "drop": {
          "schema": {
            "type": "object"
          },
          "effect": "merge"
        },
        "remark": {
          "schema": {
            "type": "object"
          },
          "effect": "none",
          "precondition": {
            "properties": {
              "status": {
                "const": "open"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },
    "token": {
      "revision": 1,
      "schema": {
        "type": "object"
      },
      "operations": {
        "create": {
          "schema": {
            "type": "object"
          },
          "effect": "merge",
          "precondition": {
            "maxProperties": 0
          }
        }
      }
    }
  },
  "cases": [
    {
      "name": "a typed birth by declared merge, then a merge",
