      "schema": {
        "type": "object",
        "required": [
          "total"
        ]
      },
      "children": {
        "comments": "comment"
      },
      "operations": {
        "create": {
          "schema": {
            "type": "object"
          },
          "effect": "merge"
        },
        "send": {
          "schema": {
            "type": "object",
            "required": [
              "to"
            ]
          },
          "effect": "merge"
        },
        "note": {
          "schema": {
            "type": "object"
          },
          "effect": "none"
        },
        "odd": {
          "schema": {
            "type": "object"
          },
          "effect": "frobnicate"
        }
      }
    },
    "comment": {
      "revision": 1,
      "schema": {},
      "children": {
        "reactions": "reaction"
      },
      "operations": {
        "create": {
          "schema": {
            "type": "object"
          },
          "effect": "merge"
        }
      }
    },
    "reaction": {
      "revision": 1,
      "schema": {}
