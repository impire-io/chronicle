        {
          "type": "create",
          "payload": {
            "total": 120
          }
        },
        {
          "type": "send",
          "payload": {
            "to": "x"
          }
        }
      ],
      "decisions": [
        "merge",
        "merge"
      ],
      "state": {
        "total": 120,
        "to": "x"
      },
      "tail": "invoice.inv-1"
    },
    {
