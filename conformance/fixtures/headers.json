          "op-1"
        ],
        "Op-Type": [
          "send"
        ],
        "Op-Author": [
          "alice"
        ],
        "Op-Parents": [
          "op-0",
          "op-x"
        ],
        "Op-Ts": [
          "2026-09-21T10:00:00Z"
        ],
